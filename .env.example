# ===================================================================
# AgriSim AI — Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# DO NOT commit real secrets or production keys to version control.
# ===================================================================

# Application Metadata
PROJECT_NAME="AgriSim AI"
VERSION="2.0.0"

# Local SQLite Database Persistence
# When using relative path, resolves automatically to the root workspace agrisim.db
DATABASE_URL="sqlite:///./agrisim.db"

# Optional Local LLM via Ollama (100% offline and privacy-preserving)
# Install Ollama from https://ollama.ai and run: ollama run llama3.2
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Optional External AI Providers (Leave unset to use the built-in deterministic rule engine)
# OPENAI_API_KEY="your-openai-api-key-here"
# OPENAI_MODEL="gpt-4o-mini"
# GEMINI_API_KEY="your-gemini-api-key-here"
# GEMINI_MODEL="gemini-1.5-flash"

# Backend CORS Allowed Origins (Comma-separated or list)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]
